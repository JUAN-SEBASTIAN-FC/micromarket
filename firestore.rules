rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isApprovedUser() {
      return request.auth != null && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status in ['approved', 'pending'];
    }

    match /users/{userId} {
      // Solo el usuario y admins pueden leer perfiles (datos sensibles)
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());

      // Crear el propio perfil: SIEMPRE nace como 'user'. Un admin se crea por
      // promoción manual (poner role:'admin' en la Consola de Firebase). Se
      // permite que nazca con cualquiera de los estados del onboarding.
      allow create: if request.auth != null && request.auth.uid == userId &&
                       request.resource.data.role == 'user' &&
                       request.resource.data.status in ['incomplete', 'pending', 'approved'];

      // Actualizar el propio perfil: el usuario puede editar sus datos y su
      // estado de verificación (incluida la auto-validación de prueba y el
      // guardado del perfil de admin que queda 'approved'), PERO NUNCA puede
      // escalar privilegios cambiando su 'role'. Eso es lo único reservado a
      // un admin: la diferencia entre 'user' y 'admin'.
      //
      // El cliente reenvía 'role' explícito en cada escritura (ver
      // completeUserProfile), por lo que request.resource.data.role siempre
      // existe y debe coincidir con el valor actual del documento.
      allow update: if request.auth != null && (
        isAdmin() ||
        (
          request.auth.uid == userId &&
          request.resource.data.role == resource.data.role
        )
      );

      allow delete: if isAdmin();
    }
    
    match /tasks/{taskId} {
      // Cualquier usuario autenticado puede LEER la lista de tareas (no es
      // dato sensible). Esto evita los 'permission-denied' que sufrían los
      // listeners (Home/Explore) cuando el perfil aún estaba 'incomplete'.
      allow read: if request.auth != null;

      // Solo usuarios aprobados (o pending) crean tareas
      allow create: if request.auth != null && isApprovedUser() && 
                       request.resource.data.authorId == request.auth.uid &&
                       request.resource.data.reward > 0 &&
                       request.resource.data.deadline != null;
      
      // ✅ Solo el autor o admin edita
      allow update: if request.auth != null && (
        resource.data.authorId == request.auth.uid || isAdmin()
      ) &&
      // Prevenir cambios en authorId
      (request.resource.data.authorId == resource.data.authorId);
      
      // ✅ Solo el autor o admin elimina
      allow delete: if request.auth != null && (
        resource.data.authorId == request.auth.uid || isAdmin()
      );
    }

    match /chats/{chatId} {
      allow read, write: if request.auth != null && (
        resource == null || 
        resource.data.creatorId == request.auth.uid || 
        resource.data.applicantId == request.auth.uid || 
        isAdmin()
      );
      
      match /messages/{messageId} {
        allow read, write: if request.auth != null && (
          get(/databases/$(database)/documents/chats/$(chatId)).data.creatorId == request.auth.uid || 
          get(/databases/$(database)/documents/chats/$(chatId)).data.applicantId == request.auth.uid || 
          isAdmin()
        );
      }
    }

    match /notifications/{notifId} {
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId != null;
    }

    // Categorías: catálogo público para usuarios autenticados.
    // Antes NO existía esta regla → toda lectura daba permission-denied
    // (Home/Explore). Solo un admin puede crear o borrar categorías.
    match /categories/{categoryId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }
  }
}

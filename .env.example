# =============================================================
# MicroMarket — Plantilla de variables de entorno (FRONTEND / Vite)
# Copiá este archivo a ".env.local" y rellená los valores reales.
# Los valores reales se obtienen de:
#   Firebase Console > Project Settings > Your apps > SDK setup
#   o con: npx firebase-tools apps:sdkconfig WEB <APP_ID>
# =============================================================

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
